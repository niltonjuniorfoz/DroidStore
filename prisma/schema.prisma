generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  password  String
  phone     String?
  cpf       String?   @unique
  birthDate DateTime?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  addresses Address[]
  favorites Favorite[]
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  brand       String
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants         Variant[]
  images           ProductImage[]
  specifications   ProductSpecification[]
  favorites        Favorite[]
  filterSelections ProductFilterSelection[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  color     String?  // Cor vinculada (ex: "Titânio Deserto")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model NavigationItem {
  id        String   @id @default(uuid())
  label     String
  href      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model SiteContent {
  id              String   @id @default("main")
  storeName       String   @default("DroidStore")
  heroEyebrow     String   @default("Tecnologia boa cabe no seu bolso")
  heroTitle       String   @default("Seu próximo Android, escolhido sem complicação.")
  heroDescription String   @default("Novos e seminovos com procedência, revisão técnica e garantia.")
  heroImageUrl    String?
  heroSlides      Json     @default("[]")
  catalogBanner   Json     @default("{}")
  catalogSlides   Json     @default("[]")
  contactEmail    String?
  whatsapp        String?
  pixDiscount     Int      @default(10)
  maxInstallments Int      @default(12)
  updatedAt       DateTime @updatedAt
}

model Variant {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  color             String?
  storage           String?
  condition         Condition
  sku               String?   @unique
  barcode           String?   // Código EAN / GTIN / Etiqueta Zebra
  price             Decimal   @db.Decimal(12, 2)
  costPrice         Decimal   @default(0) @db.Decimal(12, 2)
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  deviceUnits    DeviceUnit[]
}

model DeviceUnit {
  id                String       @id @default(uuid())
  variantId         String
  variant           Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imei1             String?      @unique
  imei2             String?
  serialNumber      String?      @unique
  batteryHealth     Int?         // % de Saúde da Bateria (ex: 88, 95, 100)
  repairedParts     String?      // Laudo de peças trocadas (ex: "Bateria Trocada", "Tela Original")
  warehouseLocation String?      // Endereçamento físico (ex: "GAVETA-03 / CORREDOR A")
  costPrice         Decimal?     @db.Decimal(12, 2)
  notes             String?
  status            DeviceStatus @default(IN_STOCK)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([variantId, status])
  @@index([imei1])
  @@index([serialNumber])
}

enum DeviceStatus {
  IN_STOCK
  RESERVED
  SOLD
  IN_MAINTENANCE
  RETURNED
}

enum Condition {
  NOVO
  NOVO_REEMBALADO
  EXCELENTE
  MUITO_BOM
  BOM
  OUTLET
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @db.Decimal(12, 2)
  paymentMethod        String      @default("PIX")
  trackingCode         String?
  shippingZipCode      String?
  shippingStreet       String?
  shippingNumber       String?
  shippingComplement   String?
  shippingNeighborhood String?
  shippingCity         String?
  shippingState        String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items         OrderItem[]
  paymentEvents PaymentEvent[]
  statusHistory OrderStatusHistory[]
}

model PaymentEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  status          String
  createdAt       DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  costPrice Decimal @default(0) @db.Decimal(12, 2)
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model StockMovement {
  id          String            @id @default(uuid())
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
}

enum StockMovementType {
  ENTRY
  ADJUSTMENT
  SALE
  RETURN
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model CatalogFilter {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options CatalogFilterOption[]

  @@index([active, position])
}

model CatalogFilterOption {
  id        String        @id @default(uuid())
  filterId  String
  filter    CatalogFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  label     String
  slug      String
  active    Boolean       @default(true)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  productSelections ProductFilterSelection[]

  @@unique([filterId, slug])
  @@index([filterId, active, position])
}

model ProductFilterSelection {
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId  String
  option    CatalogFilterOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@id([productId, optionId])
  @@index([optionId])
}
