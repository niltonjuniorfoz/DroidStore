generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  password  String
  phone     String?
  cpf       String?   @unique
  birthDate DateTime?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  addresses Address[]
  favorites Favorite[]
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  brand       String
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  imageUrl    String?
  model3dUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants         Variant[]
  images           ProductImage[]
  specifications   ProductSpecification[]
  favorites        Favorite[]
  filterSelections ProductFilterSelection[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  color     String? // Cor vinculada (ex: "Titânio Deserto")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model NavigationItem {
  id        String   @id @default(uuid())
  label     String
  href      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model SiteContent {
  id                        String   @id @default("main")
  storeName                 String   @default("Aura Tech")
  heroEyebrow               String   @default("Tecnologia boa cabe no seu bolso")
  heroTitle                 String   @default("Seu próximo Android, escolhido sem complicação.")
  heroDescription           String   @default("Novos e seminovos com procedência, revisão técnica e garantia.")
  heroImageUrl              String?
  heroSlides                Json     @default("[]")
  catalogBanner             Json     @default("{}")
  catalogSlides             Json     @default("[]")
  contactEmail              String?
  whatsapp                  String?
  pixDiscount               Int      @default(10)
  maxInstallments           Int      @default(12)
  companyLegalName          String?
  companyTaxId              String?
  companyPhone              String?
  companyAddress            String?
  companyCity               String?
  companyState              String?
  companyZipCode            String?
  customerLoginEnabled      Boolean  @default(true)
  loginTitle                String   @default("Acesse sua conta")
  loginSubtitle             String   @default("Entre para acompanhar pedidos, favoritos e finalizar suas compras.")
  transactionalEmailEnabled Boolean  @default(false)
  transactionalFromName     String?
  transactionalFromEmail    String?
  transactionalReplyTo      String?
  updatedAt                 DateTime @updatedAt
}

model Variant {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  color             String?
  storage           String?
  condition         Condition
  sku               String?   @unique
  price             Decimal   @db.Decimal(12, 2)
  costPrice         Decimal   @default(0) @db.Decimal(12, 2)
  stock             Int       @default(20)
  lowStockThreshold Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

enum Condition {
  NOVO
  NOVO_REEMBALADO
  EXCELENTE
  MUITO_BOM
  BOM
  OUTLET
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @db.Decimal(12, 2)
  paymentMethod        String      @default("PIX")
  trackingCode         String?
  shippingZipCode      String?
  shippingStreet       String?
  shippingNumber       String?
  shippingComplement   String?
  shippingNeighborhood String?
  shippingCity         String?
  shippingState        String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  paidEmailSentAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items         OrderItem[]
  paymentEvents PaymentEvent[]
  statusHistory OrderStatusHistory[]
}

model PaymentEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  status          String
  createdAt       DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  costPrice Decimal @default(0) @db.Decimal(12, 2)
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model StockMovement {
  id          String            @id @default(uuid())
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
}

enum StockMovementType {
  ENTRY
  ADJUSTMENT
  SALE
  RETURN
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model CatalogFilter {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options CatalogFilterOption[]

  @@index([active, position])
}

model CatalogFilterOption {
  id        String        @id @default(uuid())
  filterId  String
  filter    CatalogFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  label     String
  slug      String
  active    Boolean       @default(true)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  productSelections ProductFilterSelection[]

  @@unique([filterId, slug])
  @@index([filterId, active, position])
}

model ProductFilterSelection {
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId  String
  option    CatalogFilterOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@id([productId, optionId])
  @@index([optionId])
}

model ProductImport {
  id            String              @id @default(uuid())
  fileName      String
  status        ProductImportStatus @default(APPLIED)
  totalRows     Int
  changedRows   Int
  unchangedRows Int
  priceChanges  Int                 @default(0)
  costChanges   Int                 @default(0)
  stockChanges  Int                 @default(0)
  statusChanges Int                 @default(0)
  changes       Json
  createdById   String?
  createdByName String?
  createdAt     DateTime            @default(now())
  rolledBackAt  DateTime?
  rollbackById  String?

  @@index([createdAt])
  @@index([status, createdAt])
}

enum ProductImportStatus {
  APPLIED
  ROLLED_BACK
}
