generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  password  String
  phone     String?
  cpf       String?   @unique
  birthDate DateTime?
  role      Role      @default(CUSTOMER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  addresses Address[]
  favorites Favorite[]
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

model Product {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  brand           String
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  imageUrl        String?
  model3dUrl      String?
  // Desconto PIX exclusivo deste produto (%). Nulo = usa o desconto da loja.
  pixDiscountPct  Int?
  // Tabela de parcelamento própria: [{ n: 3, price: 1499.00 }, ...].
  // Nulo = parcela simples do preço de tabela.
  installmentPlan Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants         Variant[]
  images           ProductImage[]
  specifications   ProductSpecification[]
  favorites        Favorite[]
  filterSelections ProductFilterSelection[]
  views            ProductView[]

  @@index([active, updatedAt])
  @@index([brand, active])
}

// Visualização da página do produto — mede procura real (cliques) para
// comparar com vendas e decidir preço, recompra e destaque na vitrine.
model ProductView {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitorId String? // hash anônimo do visitante (sem dado pessoal)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  color     String? // Cor vinculada (ex: "Titânio Deserto")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model NavigationItem {
  id        String   @id @default(uuid())
  label     String
  href      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model SiteContent {
  id                        String    @id @default("main")
  storeMode                 StoreMode @default(INVENTORY)
  storeName                 String    @default("Aura Tech")
  heroEyebrow               String    @default("Tecnologia boa cabe no seu bolso")
  heroTitle                 String    @default("Seu próximo Android, escolhido sem complicação.")
  heroDescription           String    @default("Novos e seminovos com procedência, revisão técnica e garantia.")
  heroImageUrl              String?
  heroSlides                Json      @default("[]")
  catalogBanner             Json      @default("{}")
  catalogSlides             Json      @default("[]")
  contactEmail              String?
  whatsapp                  String?
  pixDiscount               Int       @default(10)
  maxInstallments           Int       @default(12)
  // Taxas reais cobradas pelo gateway/maquininha (%). Ajustáveis por loja:
  // o painel calcula margem e lucro com estes valores.
  pixFeePct                 Decimal   @default(0.99) @db.Decimal(6, 3)
  cardFeePct                Decimal   @default(4.98) @db.Decimal(6, 3)
  cardInstallmentFeePct     Decimal   @default(2.08) @db.Decimal(6, 3)
  companyLegalName          String?
  companyTaxId              String?
  companyPhone              String?
  companyAddress            String?
  companyCity               String?
  companyState              String?
  companyZipCode            String?
  customerLoginEnabled      Boolean   @default(true)
  loginTitle                String    @default("Acesse sua conta")
  loginSubtitle             String    @default("Entre para acompanhar pedidos, favoritos e finalizar suas compras.")
  transactionalEmailEnabled Boolean   @default(false)
  transactionalFromName     String?
  transactionalFromEmail    String?
  transactionalReplyTo      String?
  updatedAt                 DateTime  @updatedAt
}

model AdminMediaAsset {
  id          String   @id @default(uuid())
  contentType String
  data        Bytes
  filename    String
  size        Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Variant {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  color             String?
  storage           String?
  condition         Condition
  sku               String?   @unique
  price             Decimal   @db.Decimal(12, 2)
  costPrice         Decimal   @default(0) @db.Decimal(12, 2)
  stock             Int       @default(0)
  dropshipAvailable Boolean   @default(false)
  lowStockThreshold Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseLots   PurchaseLot[]
  supplierItems  SupplierCatalogItem[]

  @@index([productId, condition, price])
  @@index([storage])
}

// Entrada de mercadoria com custo na moeda original da compra.
// O custo unitário em BRL congela a cotação do dia — a margem real
// não muda quando o dólar muda depois da compra.
model PurchaseLot {
  id           String   @id @default(uuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  supplier     String
  currency     String // USD | USDT | BRL
  unitCostFx   Decimal  @db.Decimal(12, 2) // custo unitário na moeda da compra
  exchangeRate Decimal  @db.Decimal(12, 4) // cotação BRL no dia (1.0 para BRL)
  quantity     Int
  freightBrl   Decimal  @default(0) @db.Decimal(12, 2) // frete/despesas totais do lote
  unitCostBrl  Decimal  @db.Decimal(12, 2) // derivado: unitCostFx*cotação + frete/quantidade
  purchasedAt  DateTime
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([variantId, purchasedAt])
  @@index([purchasedAt])
}

enum Condition {
  NOVO
  NOVO_REEMBALADO
  EXCELENTE
  MUITO_BOM
  BOM
  OUTLET
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @db.Decimal(12, 2)
  paymentMethod        String      @default("PIX")
  trackingCode         String?
  shippingZipCode      String?
  shippingStreet       String?
  shippingNumber       String?
  shippingComplement   String?
  shippingNeighborhood String?
  shippingCity         String?
  shippingState        String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdEmailSentAt   DateTime?
  shippedEmailSentAt   DateTime?
  gatewayFeeBrl        Decimal?    @db.Decimal(12, 2) // taxa real cobrada pelo Mercado Pago
  paidEmailSentAt      DateTime?
  inventoryReserved    Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items         OrderItem[]
  paymentEvents PaymentEvent[]
  statusHistory OrderStatusHistory[]

  @@index([status, createdAt])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  status          String
  createdAt       DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  costPrice Decimal @default(0) @db.Decimal(12, 2)
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model StockMovement {
  id          String            @id @default(uuid())
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
}

enum StockMovementType {
  ENTRY
  ADJUSTMENT
  SALE
  RETURN
}

enum StoreMode {
  INVENTORY
  DROPSHIPPING
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String // ex.: "product.update", "order.status", "settings.update"
  entity     String // ex.: "Product", "Order", "SiteContent", "User"
  entityId   String?
  summary    String? // frase curta legível no painel
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}

model CatalogFilter {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options CatalogFilterOption[]

  @@index([active, position])
}

model CatalogFilterOption {
  id        String        @id @default(uuid())
  filterId  String
  filter    CatalogFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  label     String
  slug      String
  active    Boolean       @default(true)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  productSelections ProductFilterSelection[]

  @@unique([filterId, slug])
  @@index([filterId, active, position])
}

model ProductFilterSelection {
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId  String
  option    CatalogFilterOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@id([productId, optionId])
  @@index([optionId])
}

model ProductImport {
  id            String              @id @default(uuid())
  fileName      String
  status        ProductImportStatus @default(APPLIED)
  totalRows     Int
  changedRows   Int
  unchangedRows Int
  priceChanges  Int                 @default(0)
  costChanges   Int                 @default(0)
  stockChanges  Int                 @default(0)
  statusChanges Int                 @default(0)
  changes       Json
  createdById   String?
  createdByName String?
  createdAt     DateTime            @default(now())
  rolledBackAt  DateTime?
  rollbackById  String?

  @@index([createdAt])
  @@index([status, createdAt])
}

enum ProductImportStatus {
  APPLIED
  ROLLED_BACK
}

model Supplier {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  currency          String   @default("USD")
  active            Boolean  @default(true)
  allowedDomains    Json     @default("[]")
  xlsxColumnMapping Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  catalogItems      SupplierCatalogItem[]
  pricingRules      SupplierPricingRule[]
  categoryMappings  SupplierCategoryMapping[]
  conditionMappings SupplierConditionMapping[]
  imageAssets       SupplierImageAsset[]
  importJobs        AuraImportJob[]
}

model SupplierCatalogItem {
  id                String   @id @default(uuid())
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sku               String
  sourceUrl         String?
  sourceGroup       String?
  sourceSubgroup    String?
  sourceCategory    String?
  categoryPath      Json     @default("[]")
  sourceName        String?
  sourceBrand       String?
  sourceModel       String?
  sourceColor       String?
  sourceStorage     String?
  sourceCondition   String?
  supplierPriceUsd  Decimal? @db.Decimal(12, 2)
  lastKnownPriceUsd Decimal? @db.Decimal(12, 2)
  exchangeRate      Decimal? @db.Decimal(12, 4)
  markupPercent     Decimal? @db.Decimal(7, 2)
  salePriceBrl      Decimal? @db.Decimal(12, 2)
  available         Boolean  @default(false)
  sourceImages      Json     @default("[]")
  rawData           Json?
  lastSeenAt        DateTime @default(now())
  lastImportedAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([supplierId, sku])
  @@index([variantId])
  @@index([available])
  @@index([sourceGroup, sourceSubgroup])
}

model SupplierPricingRule {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  brand         String
  markupPercent Decimal  @db.Decimal(7, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, brand])
  @@index([supplierId, active])
}

model SupplierCategoryMapping {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceGroup    String
  sourceSubgroup String   @default("")
  optionIds      Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supplierId, sourceGroup, sourceSubgroup])
  @@index([supplierId, sourceGroup, sourceSubgroup])
}

model SupplierConditionMapping {
  id              String    @id @default(uuid())
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceCondition String
  condition       Condition
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([supplierId, sourceCondition])
  @@index([supplierId])
}

model SupplierImageAsset {
  id           String   @id @default(uuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceUrl    String
  permanentUrl String
  contentType  String
  size         Int
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([supplierId, sourceUrl])
  @@index([supplierId, lastUsedAt])
}

model AuraImportJob {
  id             String           @id @default(uuid())
  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind           AuraImportKind   @default(AURA_JSON)
  status         AuraImportStatus @default(UPLOADED)
  fileName       String
  sourceFileUrl  String?
  generator      String?
  schemaVersion  Int?
  exchangeRate   Decimal?         @db.Decimal(12, 4)
  roundingRule   AuraRoundingRule @default(CEIL_10)
  configuration  Json             @default("{}")
  summary        Json             @default("{}")
  totalItems     Int              @default(0)
  preparedItems  Int              @default(0)
  processedItems Int              @default(0)
  createdItems   Int              @default(0)
  updatedItems   Int              @default(0)
  unchangedItems Int              @default(0)
  reviewItems    Int              @default(0)
  errorItems     Int              @default(0)
  createdById    String?
  createdByName  String?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  rolledBackAt   DateTime?
  rollbackById   String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items AuraImportItem[]

  @@index([supplierId, createdAt])
  @@index([status, updatedAt])
  @@index([kind, createdAt])
}

model AuraImportItem {
  id             String               @id @default(uuid())
  jobId          String
  job            AuraImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber      Int
  sku            String
  name           String
  brand          String?
  sourceGroup    String?
  sourceSubgroup String?
  groupKey       String?
  action         AuraImportAction
  status         AuraImportItemStatus @default(PENDING)
  quality        String               @default("ok")
  messages       Json                 @default("[]")
  sourceData     Json
  computedData   Json                 @default("{}")
  beforeSnapshot Json?
  afterSnapshot  Json?
  productId      String?
  variantId      String?
  reviewedById   String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@index([jobId, action])
  @@index([jobId, sku])
  @@index([jobId, groupKey])
}

enum AuraImportKind {
  AURA_JSON
  SUPPLIER_XLSX
}

enum AuraImportStatus {
  UPLOADED
  PREVIEW
  READY
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
  PARTIAL_ROLLBACK
}

enum AuraImportAction {
  CREATE
  UPDATE
  UNCHANGED
  REVIEW
  ERROR
}

enum AuraImportItemStatus {
  PENDING
  CREATED
  UPDATED
  UNCHANGED
  REVIEW
  ERROR
  IGNORED
  ROLLED_BACK
}

enum AuraRoundingRule {
  CEIL_10
  NEAREST_10
  CEIL_50
  CEIL_100
}
